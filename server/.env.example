# Copy this file to "server/.env" and fill in the values.

# ---------------------------------------------------------------
# Riot RSO (League of Legends account sign-in / linking)
# ---------------------------------------------------------------
# 1. Go to https://developer.riotgames.com and sign in.
# 2. Create an application.
# 3. Under "OAuth" / "redirect URIs", add EXACTLY this value:
#    http://localhost:3000/api/riot/callback   (or your deployed URL)
# 4. Copy the Client ID and Client Secret below.
RIOT_CLIENT_ID=
RIOT_CLIENT_SECRET=
RIOT_REDIRECT_URI=http://localhost:3000/api/riot/callback

# Account region used to look up summoner info (americas / europe / asia).
RIOT_REGION=europe

# Platform used for the summoner/level lookup (euw1 / eun1 / na1 / kr ...).
# Defaults are: europe -> euw1, americas -> na1, asia -> kr.
RIOT_PLATFORM=euw1

# ---------------------------------------------------------------
# Player stats (level, most-played champs, last 30 matches)
# ---------------------------------------------------------------
# 1. Go to https://developer.riotgames.com and sign in.
# 2. Create an application (if you haven't already) and grab a
#    DEVELOPMENT API KEY (starts with "RGAPI-").
# 3. Paste it below. The key expires after 24h on the dev tier.
RIOT_API_KEY=RGAPI-b26e794a-efee-471f-8c0e-02031aa2bc45

# ---------------------------------------------------------------
# Firebase (Google / email sign-in + storing linked accounts)
# ---------------------------------------------------------------
# 1. Go to https://console.firebase.google.com and create a project.
# 2. Enable Firestore (Datastore mode: Firestore) and create a "users" collection.
# 3. Enable sign-in providers: Authentication -> Sign-in method ->
#    Google (enabled) and Email/Password (enabled).
# 4. Project settings -> Service accounts -> "Generate new private key".
#    Save the downloaded JSON into this folder (server/) and point to it here.
FIREBASE_SERVICE_ACCOUNT=serviceAccount.json

# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
PORT=3000
